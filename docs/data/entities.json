": "同回罩在蜜合色棉袄之外；热闹体面里的一段自守之冷"}, {"name": "缕金百蝶穿花大红洋缎窄褃袄", "owner": "王熙凤", "category": "成衣", "symbol": "第三回「彩绣辉煌，恍若神妃仙子」，凤姐出场之焰在此一袄"}, {"name": "翡翠撒花洋绉裙", "owner": "王熙凤", "category": "成衣", "symbol": "同上之下裳；与桃红撒花袄并为凤姐两副面孔"}, {"name": "桃红撒花袄", "owner": "王熙凤", "category": "成衣", "symbol": "第六回家常装束：紫貂昭君套、攒珠勒子、石青刻丝灰鼠披风、大红洋绉银鼠皮裙，粉光脂艳，又是一般"}, {"name": "束发嵌宝紫金冠", "owner": "贾宝玉", "category": "首服", "symbol": "第三回黛玉眼中「头上戴着束发嵌宝紫金冠」（第八回作「缧丝嵌宝紫金冠」，本之讹字）"}, {"name": "二龙抢珠金抹额", "owner": "贾宝玉", "category": "首服", "symbol": "「齐眉勒着」，第三、八两回皆见；一件抹额，先把宝玉钉在侯门公子的位上"}, {"name": "紫貂昭君套", "owner": "王熙凤", "category": "首服", "symbol": "第六回家常戴此，傍着攒珠勒子；闺房里的排场，比堂前更见权势"}, {"name": "攒珠勒子", "owner": "王熙凤", "category": "首服", "symbol": "同上。勒子紧要处在一「勒」字——这等人物的体面是勒出来的"}, {"name": "猩猩毡昭君套", "owner": "史湘云", "category": "首服", "symbol": "第四十九回「挖云鹅黄片金里大红猩猩毡昭君套」，又围着大貂鼠风领，被黛玉笑作孙行者、小骚达子"}, {"name": "观音兜", "owner": "贾探春", "category": "首服", "symbol": "第四十九回雪中「围着大红猩猩毡斗篷，戴着观音兜，扶着小丫头」——冒雪赴贾母处，是探春的干练模样"}, {"name": "雪帽", "owner": "林黛玉", "category": "首服", "symbol": "第四十九回踏雪赴稻香村所罩；一顶雪帽也要「掐金挖云」，是写足了细密，也写足了娇弱"}, {"name": "掐金挖云红香羊皮小靴", "owner": "林黛玉", "category": "足衣", "symbol": "第四十九回换上，罩鹤氅、束四合如意绦，方出门踏雪"}, {"name": "麀皮小靴", "owner": "史湘云", "category": "足衣", "symbol": "同上回里头短打扮的一双，束宫绦，显出「蜂腰猿背，鹤势螂形」"}, {"name": "青缎粉底小朝靴", "owner": "贾宝玉", "category": "足衣", "symbol": "第三回那套行头的最下一件；曰「朝靴」，是早有人替他备下仕途经济的路了"}, {"name": "沙棠屐", "owner": "贾宝玉", "category": "足衣", "symbol": "第四十九回「登上沙棠屐」，冒雪独往芦雪广"}, {"name": "玉针蓑", "owner": "贾宝玉", "category": "雨具", "symbol": "同上回披之戴笠而来，婆子们笑「正少一个渔翁」；宝玉一生最好的一幅小影"}, {"name": "金藤笠", "owner": "贾宝玉", "category": "雨具", "symbol": "同上。第八回另有大红猩毡斗笠，戴上嫌蠢——少年之不耐繁琐，斗笠上见"}, {"name": "长命锁", "owner": "贾宝玉", "category": "佩饰", "symbol": "第八回项上与通灵宝玉并悬者，尚有长命锁、记名符：一为俗世之咒，一为前生之石"}], "concepts": [{"name": "情", "category": "哲学", "gloss": "情榜之纲，情不情/情情之辨；「厚地高天，堪叹古今情不尽」"}, {"name": "幻", "category": "哲学", "gloss": "太虚幻境、幻形入世；「假作真时真亦假」"}, {"name": "空", "category": "哲学", "gloss": "万境归空，白茫茫大地真干净"}, {"name": "真假", "category": "结构", "gloss": "